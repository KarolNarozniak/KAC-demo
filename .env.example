POSTGRES_USER=kac
POSTGRES_PASSWORD=kac_local_only
POSTGRES_DB=kac_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kac:kac_local_only@localhost:5432/kac_dev
API_PORT=4000
API_CORS_ORIGINS=http://localhost:8081,http://localhost:8080,http://localhost:3000
OPENAPI_SERVER_URL=http://localhost:4000
# Set the public API address when the Docusaurus site and API are deployed separately.
# API_ORIGIN=http://localhost:4000
# API_OPENAPI_URL=http://localhost:4000/api/v1/openapi.json
# DOCUSAURUS_URL=http://localhost:3000
# DOCUSAURUS_BASE_URL=/

# Azure AI Foundry (local: az login; production: managed identity on the API App Service)
# No client secret or API key should be stored here.
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT=gpt-5-mini
AZURE_AI_AUTH_MODE=azure-cli
# AZURE_AI_AUTH_MODE=managed-identity
# AZURE_AI_CLIENT_ID=only-for-user-assigned-managed-identity
# AZURE_AI_AGENT_NAME is only used by the optional hosted-agent smoke-test script; the API uses the model deployment directly.
# AZURE_AI_AGENT_NAME=jovial-agent-...
# Premium activation: set the code only as an API/App Service secret (Key Vault reference in Azure), never as EXPO_PUBLIC_*.
# PREMIUM_REDEMPTION_CODE=
# PREMIUM_CAMPAIGN_ID=black-friday-2026
# PREMIUM_CAMPAIGN_NAME=Black Friday
# PREMIUM_CAMPAIGN_ENDS_AT=2026-11-30T22:59:59Z (23:59:59 Europe/Warsaw)
# PREMIUM_DURATION_DAYS=365
AZURE_AI_TIMEOUT_MS=60000
AZURE_AI_MAX_FILE_BYTES=5242880
AZURE_AI_MAX_PDF_PAGES=10
AZURE_AI_MAX_IMAGE_PIXELS=20000000
AZURE_AI_MAX_TOOL_ROUNDS=8
AI_CONVERSATION_RETENTION_DAYS=30
AI_ACTION_TTL_MINUTES=15
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20
# Optional Web Push for notifications while the app is closed. Generate a key pair once with `npx web-push generate-vapid-keys`.
# Keep WEB_PUSH_VAPID_PRIVATE_KEY only in the API/worker secret store; it is never exposed to the frontend.
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
# Odczyt grafiku pracy (S23KC2S1P2-44): local = PDF + OCR na serwerze (domyślnie), demo = przykładowy grafik bez OCR
# WORK_SCHEDULE_READER=local
# WORK_SCHEDULE_DEBUG=1 wypisuje odczytany tekst grafiku w terminalu API (tylko lokalnie, do diagnozy)
# Import z Google Calendar (S23KC2S1P2-27). Bez tych zmiennych działa przykładowe konto Google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/import/google/callback
# Trwałe połączenie z Google Calendar (S23KC2S1P2-12): ten sam klient OAuth, osobny adres powrotu – dodaj go też w Google Cloud Console.
# GOOGLE_INTEGRATION_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback
# Klucz szyfrowania tokenów Google w bazie (32 bajty w base64). Wygeneruj raz: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trzymaj go poza bazą i poza repozytorium (lokalnie w .env, w Azure w ustawieniach aplikacji). Zmiana klucza wymaga ponownego połączenia kont.
# Bez klucza prawdziwe logowanie Google jest wyłączone; makieta (bez GOOGLE_CLIENT_ID) go nie potrzebuje.
# GOOGLE_TOKEN_ENCRYPTION_KEY=
# Publikacja grafiku i korekty opublikowanych zmian (G07, G09): konta Google zapisują wydarzenia naprawdę.
# simulation wyłącza zapis do Google także dla nich (konta demonstracyjne zawsze działają jako symulacja).
# GOOGLE_PUBLICATION_MODE=simulation
# Logowanie do KAC (e-mail i hasło, sesje w bazie). Rejestracja nowych kont: open (każdy), invite (z kodem zaproszenia), closed (konta zakłada administrator:
# npm run auth:set-password -- adres@example.test --create). Na publicznym serwerze (Azure) ustaw invite albo closed. invite bez kodu działa jak closed.
# REGISTRATION_MODE=open
# REGISTRATION_INVITE_CODE=
# Dzienny limit wywołań Azure AI na konto (asystent i odczyt planu przez AI) w ciągu 24 godzin; 0 wyłącza limit.
# AI_DAILY_LIMIT=200
# Limity logowania liczą adres klienta. Za serwerem pośredniczącym podaj, ilu pośrednikom ufać (X-Forwarded-For); w Azure App Service domyślnie 1.
# TRUST_PROXY=1
