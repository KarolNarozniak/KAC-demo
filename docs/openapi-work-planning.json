    "/api/schedules/generate": {
      "post": {
        "tags": [
          "Scheduling"
        ],
        "summary": "Generowanie propozycji",
        "description": "Wymaga ustawienia stawki, rodzaju kwoty, dojazdu i celu; brak daje profile_incomplete z details.fields. Algorytm deterministyczny wypełnia najwcześniejsze poprawne okna, respektuje maksymalną liczbę godzin. Nie gwarantuje globalnie optymalnego planu. Brak okien daje pustą propozycję i achievable=false, jeśli cel > 0. Płatna praca mieści się w tygodniu; bufor może korzystać z ciągłej dostępności sąsiedniego tygodnia. Wydarzenia cykliczne materializowane w strefie kalendarza, odstępy liczone na instantach. Między Work i Class/Personal wymagany commuteMinutes, między Work i Work max(commuteMinutes,minRestMinutes), bez sumowania. Bufor mieści się w ciągłym oknie dostępności. Nie powstają wydarzenia dojazdu ani pracy do chwili akceptacji.",
        "responses": {
          "200": {
            "description": "Sukces",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleSummary"
                }
              }
            }
          },
          "400": {
            "description": "Niepoprawna struktura, format lub data. Nieznane właściwości i konwersja typów nie są dozwolone.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "404": {
            "description": "Brak własnego aktywnego profilu, kalendarza lub grafiku.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "409": {
            "description": "version_conflict — profil zmieniony, albo schedule_closed — propozycja już zamknięta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "422": {
            "description": "Błąd semantyczny: availability_overlap, invalid_hourly_rate, rate_kind_required, invalid_hour_limits, profile_incomplete, invalid_shift, pay_overflow, max_hours_exceeded lub schedule_constraints.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                },
                "examples": {
                  "gap": {
                    "value": {
                      "error": "schedule_constraints",
                      "details": {
                        "violations": [
                          {
                            "error": "commute_gap_too_short",
                            "requiredMinutes": 30,
                            "actualMinutes": 15,
                            "leftId": "class-1",
                            "rightId": "shift-1"
                          }
                        ]
                      }
                    }
                  },
                  "availabilityBoundary": {
                    "value": {
                      "error": "schedule_constraints",
                      "details": {
                        "violations": [
                          {
                            "error": "commute_outside_availability",
                            "shiftId": "shift-1",
                            "requiredMinutes": 30
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Baza nie jest skonfigurowana albo jest niedostępna. Zapis nie zmienia części danych.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "week"
                ],
                "properties": {
                  "week": {
                    "type": "string",
                    "format": "date",
                    "description": "Poprawna data poniedziałku w strefie kalendarza."
                  }
                }
              }
            }
          }
        }
      }
    },
