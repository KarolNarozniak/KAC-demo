          },
          "404": {
            "description": "Brak własnego aktywnego profilu, kalendarza lub grafiku.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "409": {
            "description": "version_conflict — profil zmieniony, albo schedule_closed — propozycja już zamknięta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "503": {
            "description": "Baza nie jest skonfigurowana albo jest niedostępna. Zapis nie zmienia części danych.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "WorkProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "hourlyRatePln",
          "rateKind",
          "commuteMinutes",
          "minRestMinutes",
          "minHours",
          "targetHours",
          "maxHours"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "hourlyRatePln": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 9999999999.99,
                "multipleOf": 0.01
              },
              {
                "type": "null"
              }
            ],
            "description": "PLN/h; null = brak stawki i profile_incomplete przy generowaniu. Zero jest jawną poprawną stawką."
          },
          "rateKind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "gross",
                  "net"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "gross = brutto, net = netto. Wymagane przy ustawionej stawce. Bez konwersji podatkowej."
          },
          "commuteMinutes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 10080
              },
              {
                "type": "null"
              }
            ],
            "description": "Jeden stały bufor MVP przed i po pracy, również dla pustego location; bez map i geokodowania. Null oznacza nieustawiony dojazd i blokuje planowanie; 0 jest poprawne."
          },
          "minRestMinutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10080
          },
          "minHours": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 999.99,
                "multipleOf": 0.01
              },
              {
                "type": "null"
              }
            ]
          },
          "targetHours": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 999.99,
                "multipleOf": 0.01
              },
              {
                "type": "null"
              }
            ]
          },
          "maxHours": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 999.99,
                "multipleOf": 0.01,
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "example": {
          "version": 1,
          "hourlyRatePln": 30,
          "rateKind": "gross",
          "commuteMinutes": 30,
          "minRestMinutes": 660,
          "minHours": 10,
          "targetHours": 20,
          "maxHours": 30
        }
      },
      "AvailabilityInterval": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dayOfWeek",
          "startTime",
          "endTime"
        ],
        "properties": {
          "dayOfWeek": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "startTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "endTime": {
            "type": "string",
            "pattern": "^(([01]\\d|2[0-3]):[0-5]\\d|24:00)$"
          }
        }
      },
      "AvailabilityResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "intervals"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "intervals": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/AvailabilityInterval"
            }
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {}
        }
      },
      "CommuteViolation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "requiredMinutes",
          "actualMinutes",
          "leftId",
          "rightId"
        ],
        "properties": {
          "error": {
            "const": "commute_gap_too_short"
          },
          "requiredMinutes": {
            "type": "number",
            "minimum": 0
          },
          "actualMinutes": {
            "type": "number",
            "description": "Ujemne przy nakładaniu samych wydarzeń."
          },
          "leftId": {
            "type": "string"
          },
          "rightId": {
            "type": "string"
          },
          "leftTitle": {
            "type": "string"
          },
          "rightTitle": {
            "type": "string"
          }
        },
        "example": {
          "error": "commute_gap_too_short",
          "requiredMinutes": 30,
          "actualMinutes": 15,
          "leftId": "class-1",
          "rightId": "shift-1"
        }
      },
      "AvailabilityViolation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "shiftId",
          "requiredMinutes"
        ],
        "properties": {
          "error": {
            "const": "commute_outside_availability"
          },
          "shiftId": {
            "type": "string"
          },
          "requiredMinutes": {
            "type": "number",
            "minimum": 0
          }
        },
        "example": {
          "error": "commute_outside_availability",
          "shiftId": "shift-1",
          "requiredMinutes": 30
        }
      },
      "ScheduleShift": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start",
          "end",
          "category",
          "hourlyRatePln",
          "estimatedPayPln",
          "rateKind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "category": {
            "const": "Work"
          },
          "hourlyRatePln": {
            "type": "number",
            "minimum": 0,
            "description": "Trwały snapshot stawki PLN/h w momencie generowania. Nie aktualizuje się po zmianie profilu."
          },
          "estimatedPayPln": {
            "type": "number",
            "minimum": 0,
            "description": "Snapshot kwoty: halfUp(rateGrosz × rzeczywiste minuty / 60) / 100; zaokrąglanie osobno dla każdej zmiany."
          },
          "rateKind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "gross",
                  "net"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ScheduleSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "week",
          "commuteMinutes",
          "plannedHours",
          "targetHours",
          "estimatedPayPln",
          "achievable",
          "shifts"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Proposed",
              "Accepted",
              "Rejected"
            ]
          },
          "week": {
            "type": "string",
            "format": "date"
          },
          "commuteMinutes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 10080
              },
              {
                "type": "null"
              }
            ]
          },
          "plannedHours": {
            "type": "number",
            "minimum": 0
          },
          "targetHours": {
            "type": "number",
            "minimum": 0
          },
          "estimatedPayPln": {
            "type": "number",
            "minimum": 0,
            "description": "Suma kwot zaokrąglonych osobno dla zmian, a nie ponowne przeliczenie łącznego czasu. Zero przy braku zmian. Dojazd nie jest płatny."
          },
          "achievable": {
            "type": "boolean"
          },
          "shifts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleShift"
            }
          }
        }
      },
      "ShiftEdit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "Rzeczywisty instant z Z lub offsetem, sekundy 00; pełne minuty."
          },
          "end": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
