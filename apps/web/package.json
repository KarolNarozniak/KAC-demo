{
  "name": "@kac/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node server.mjs",
    "start:dev": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "package:deploy": "node scripts/package-deploy.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.17",
    "expo-asset": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "@types/node": "^24.0.0"
  }
}
