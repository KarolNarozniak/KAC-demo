API_PORT=4000
API_CORS_ORIGINS=http://localhost:8081,http://localhost:8080,http://localhost:3000
DATABASE_URL=postgresql://kac:kac_local_only@localhost:5432/kac_dev
DB_DEMO_USER_ID=U001
DB_DEMO_CALENDAR_ID=K001

# Azure AI Foundry (local: az login; production: managed identity on the API App Service)
# No client secret or API key should be stored here.
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT=gpt-5-mini
AZURE_AI_AUTH_MODE=azure-cli
# AZURE_AI_AUTH_MODE=managed-identity
# AZURE_AI_CLIENT_ID=only-for-user-assigned-managed-identity
# AZURE_AI_AGENT_NAME is for optional preview-agent diagnostics only, not the runtime API.
# AZURE_AI_AGENT_NAME=jovial-agent-...
AZURE_AI_TIMEOUT_MS=60000
AZURE_AI_MAX_FILE_BYTES=5242880
AZURE_AI_MAX_PDF_PAGES=10
AZURE_AI_MAX_IMAGE_PIXELS=20000000
AZURE_AI_MAX_TOOL_ROUNDS=3
AI_CONVERSATION_RETENTION_DAYS=30
AI_ACTION_TTL_MINUTES=15
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20
# Optional Web Push for notifications while the app is closed. Generate a key pair once with `npx web-push generate-vapid-keys`.
# Keep WEB_PUSH_VAPID_PRIVATE_KEY only in the API/worker secret store; it is never exposed to the frontend.
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
