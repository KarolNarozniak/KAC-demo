{
  "openapi": "3.1.0",
  "info": {
    "title": "KAC — Work profile and scheduling",
    "version": "1.0.0",
    "description": "Kontrakt modułów sprintu 204. Jest dokumentem uzupełniającym istniejące API kalendarza/importu. Tożsamość MVP wybierana na serwerze przez DB_DEMO_USER_ID/DB_DEMO_CALENDAR_ID; brak parametrów właściciela w żądaniach. Nie jest to uwierzytelnianie produkcyjne."
  },
  "tags": [
    {
      "name": "Work profile"
    },
    {
      "name": "Scheduling"
    }
  ],
  "paths": {
    "/api/work-profile": {
      "get": {
        "tags": [
          "Work profile"
        ],
        "summary": "Odczyt aktywnego profilu",
        "description": "",
        "responses": {
          "200": {
            "description": "Sukces",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkProfile"
                }
              }
            }
          },
          "404": {
            "description": "Brak własnego aktywnego profilu, kalendarza lub grafiku.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "503": {
            "description": "Baza nie jest skonfigurowana albo jest niedostępna. Zapis nie zmienia części danych.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Work profile"
        ],
        "summary": "Zapis pełnego profilu z wersją",
        "description": "Zwiększa wersję wspólną z dostępnością. Nie zmienia wydarzeń ani snapshotów. 0 jest dozwolone; null oznacza brak. Kwota wymaga gross lub net; maksimum dwie cyfry po przecinku, numeric(12,2).",
        "responses": {
          "200": {
            "description": "Sukces",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkProfile"
                }
              }
            }
          },
          "400": {
            "description": "Niepoprawna struktura, format lub data. Nieznane właściwości i konwersja typów nie są dozwolone.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "404": {
            "description": "Brak własnego aktywnego profilu, kalendarza lub grafiku.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "409": {
            "description": "version_conflict — profil zmieniony, albo schedule_closed — propozycja już zamknięta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "422": {
            "description": "Błąd semantyczny: availability_overlap, invalid_hourly_rate, rate_kind_required, invalid_hour_limits, profile_incomplete, invalid_shift, pay_overflow, max_hours_exceeded lub schedule_constraints.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                },
                "example": {
                  "error": "invalid_hourly_rate"
                }
              }
            }
          },
          "503": {
            "description": "Baza nie jest skonfigurowana albo jest niedostępna. Zapis nie zmienia części danych.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkProfile"
              }
            }
          }
        }
      }
    },
