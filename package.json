{
  "name": "kac-platform",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "database"
  ],
  "scripts": {
    "start": "npm run web:dev",
    "web:dev": "npm run web --workspace @kac/web",
    "web:start": "npm run start --workspace @kac/web",
    "api:dev": "npm run dev --workspace @kac/api",
    "api:start": "npm run start --workspace @kac/api",
    "build:web": "npm run build:web --workspace @kac/web",
    "build:api": "npm run build --workspace @kac/api",
    "build": "npm run db:check && npm run build:api && npm run build:web",
    "typecheck:web": "npm run typecheck --workspace @kac/web",
    "typecheck:api": "npm run typecheck --workspace @kac/api",
    "typecheck": "npm run typecheck:web && npm run typecheck:api",
    "test:web": "npm run test --workspace @kac/web",
    "test:api": "npm run test --workspace @kac/api",
    "test:api:db": "npm run test:db --workspace @kac/api",
    "test": "npm run test:web && npm run test:api",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate --workspace @kac/database",
    "db:seed": "npm run seed --workspace @kac/database",
    "db:check": "npm run check --workspace @kac/database",
    "db:setup-local": "npm run db:up && npm run db:migrate && npm run db:seed"
  }
}
